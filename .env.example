# Firebase Web Configuration
# Retrieve these from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyDummyApiKeyForDemoEvaluation_ReplaceWithYourActualKey
VITE_FIREBASE_AUTH_DOMAIN=koodi-maatadona.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=koodi-maatadona
VITE_FIREBASE_STORAGE_BUCKET=koodi-maatadona.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Gemini AI API Configuration (Processed Server-Side, NEVER exposed to client)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port
PORT=5000

